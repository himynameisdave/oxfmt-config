{
  "name": "@himynameisdave/oxfmt-config",
  "version": "0.0.0",
  "description": "An opinionated oxfmt config, by and for himynameisdave.",
  "keywords": [
    "config",
    "format",
    "formatter",
    "himynameisdave",
    "oxc",
    "oxfmt",
    "oxfmt-config",
    "prettier"
  ],
  "homepage": "https://github.com/himynameisdave/oxfmt-config",
  "bugs": {
    "url": "https://github.com/himynameisdave/oxfmt-config/issues"
  },
  "license": "MIT",
  "author": "Dave Lunny <d@velunny.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himynameisdave/oxfmt-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check-coverage": "tsc && bun scripts/check-coverage.ts",
    "format": "tsc && oxfmt --write",
    "format:check": "tsc && oxfmt --check",
    "lint": "tsc && oxlint -c oxlint.config.ts --deny-warnings",
    "prepublishOnly": "npm run build",
    "test": "bun run lint && bun run format:check && bun run check-coverage && bun run test:consumer",
    "test:consumer": "tsc && bun scripts/consumer-smoke.ts"
  },
  "devDependencies": {
    "@himynameisdave/oxlint-config": "^1.2.0",
    "@types/bun": "^1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.56.10",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": ">=0.65.0 <1"
  },
  "packageManager": "bun@1.3.13"
}
